# docker compose가 읽는다. .env로 복사해 값을 바꾼다 (.env는 커밋하지 않는다).
# 앱 계정 비밀번호(*_APP_PASSWORD)에 | & \ ' $ # 공백은 쓰지 않는다. 있으면 DB 초기화가 실패한다.
MARIADB_ROOT_PASSWORD=change-me
USER_APP_PASSWORD=change-me
MATCH_APP_PASSWORD=change-me
FACILITY_APP_PASSWORD=change-me
NOTIFICATION_APP_PASSWORD=change-me

# user-service와 gateway-service가 같은 값을 쓴다. 32바이트 이상이어야 기동한다.
# 값이 비어 있으면 기동하지 않는다. openssl rand -base64 48 결과를 넣는다.
JWT_SECRET_KEY=

# RabbitMQ(Spring Cloud Bus) 계정. config-service와 서비스 6개가 같은 값을 쓴다. 로컬은 guest 그대로 둔다(운영은 반드시 다른 값).
# 빈 값으로 두지 않는다. IDE로 띄운 서비스는 이 파일을 읽어서 빈 값이면 RabbitMQ 인증에 실패한다.
# $ 는 쓰지 않는다(Compose가 변수로 읽음).
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 개발·시연용 관리자 계정. 둘 다 넣으면 user-service가 기동할 때 이 계정이 없을 때만 ADMIN으로 만든다.
# 비밀번호는 8~20자, $ 는 쓰지 않는다(Compose가 변수로 읽음). 비워 두면 만들지 않는다.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 관리자 닉네임(비우면 "관리자"). 이미 쓰이는 닉네임이면 계정을 만들지 않으니 그때 바꾼다.
ADMIN_NICKNAME=

# 서울시 공공데이터(체육시설 예약) API 키. facility-service가 매일 03:00 동기화에 쓴다.
# 비어 있으면 동기화만 건너뛰고 서비스는 정상 기동한다. 키는 팀 채널에서 따로 받는다.
PUBLIC_DATA_API_KEY=

# OpenAI API 키. ai-service가 AI 검색·초안·추천에 쓴다. 키는 팀 채널에서 따로 받는다.
# 키가 없거나 비어 있어도 ai-service는 기동한다(호출만 실패해 초안 503, 검색·추천 Fallback).
# OPENAI_API_KEY=
# 시연 대비: true면 OpenAI 없이 문장 속 단어로 AI 초안·검색·추천을 만든다(기본 false).
# 기동할 때 한 번 읽으므로 바꾼 뒤 ai-service를 재시작해야 한다(Bus refresh로는 바뀌지 않음).
# AI_MOCK_ENABLED=true

# 프론트 주소가 기본값과 다르면 주석을 풀고 바꾼다. gateway-service가 CORS 허용 출처로 쓴다.
# CORS_ALLOWED_ORIGIN=http://localhost:3000

# Prometheus 주소가 Compose 기본값과 다르면 주석을 풀고 바꾼다. gateway-service가 조회 경로를 이 주소로 넘긴다.
# PROMETHEUS_URL=http://prometheus:9090

# 호스트 포트가 이미 쓰이면 바꾼다. IDE로 띄운 서비스(local 프로필)도 이 포트로 붙는다.
# IDE 실행 전에 docker compose up -d --wait config-service로 Config Server를 먼저 띄운다.
# CONFIG_HOST_PORT를 바꾸면 IDE 실행 환경변수 CONFIG_SERVER_URL도 http://localhost:<포트>로 맞춘다.
CONFIG_HOST_PORT=8888
MARIADB_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
GATEWAY_HOST_PORT=8000
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Zipkin 로컬 접속 포트
ZIPKIN_HOST_PORT=9411

# Prometheus 로컬 접속 포트
PROMETHEUS_HOST_PORT=9090

# Grafana 로컬 모니터링. .env의 비밀번호를 실제 값으로 바꾼다.
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me

# Discord 운영 알림. 실제 URL은 .env에만 저장한다. 비어 있으면 전송만 비활성화한다.
DISCORD_WEBHOOK_URL=
ALERTMANAGER_HOST_PORT=9093

# 배포용(deploy/README.md). 로컬 개발에는 필요 없다.
# infra EC2 사설 IP. deploy/infra가 DB·Redis·Kafka·Prometheus를 이 주소에 열고, Kafka도 이 주소로 광고한다.
# INFRA_PRIVATE_IP=
# 단일 서버 배포(deploy/single)가 받는 Docker Hub 이미지. FRONTEND_IMAGE_TAG를 비우면 IMAGE_TAG를 쓴다.
# DOCKERHUB_NAMESPACE=
# IMAGE_TAG=
# FRONTEND_IMAGE_TAG=
