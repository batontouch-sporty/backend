# docker compose가 읽는다. .env로 복사해 값을 바꾼다 (.env는 커밋하지 않는다).
# 앱 계정 비밀번호(*_APP_PASSWORD)에 | & \ ' $ # 공백은 쓰지 않는다. 있으면 DB 초기화가 실패한다.
MARIADB_ROOT_PASSWORD=change-me
USER_APP_PASSWORD=change-me
MATCH_APP_PASSWORD=change-me
FACILITY_APP_PASSWORD=change-me
NOTIFICATION_APP_PASSWORD=change-me

# user-service와 gateway-service가 같은 값을 쓴다. 32바이트 이상이어야 기동한다.
JWT_SECRET_KEY=change-me

# 프론트 주소가 기본값과 다르면 주석을 풀고 바꾼다. gateway-service가 CORS 허용 출처로 쓴다.
# CORS_ALLOWED_ORIGIN=http://localhost:3000

# Prometheus 주소가 기본값과 다르면 주석을 풀고 바꾼다. gateway-service가 조회 경로를 이 주소로 넘긴다.
# PROMETHEUS_URL=http://localhost:9090

# 호스트 포트가 이미 쓰이면 바꾼다.
MARIADB_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
