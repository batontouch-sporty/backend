                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (application, client_name) (rate(http_client_requests_seconds_sum{application=~\".+\"}[$__rate_interval])) / (sum by (application, client_name) (rate(http_client_requests_seconds_count{application=~\".+\"}[$__rate_interval])))",
