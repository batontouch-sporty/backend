{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "sporty-service-communication",
    "namespace": "default"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Match Service 회원·시설 Circuit Breaker와 실제 Feign HTTP 요청 계측을 분리해 표시합니다.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Circuit Breaker 현재 상태",
          "description": "현재 활성 상태의 시계열만 표시합니다. application·instance·name·state를 확인합니다. 값 1 자체는 정상 여부가 아니라 해당 state가 활성이라는 뜻입니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "resilience4j_circuitbreaker_state{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\"} == 1",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{instance}} / {{name}} / {{state}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true,
                        "__name__": true,
                        "group": true,
                        "job": true
                      },
                      "renameByName": {
                        "application": "호출 서비스",
                        "instance": "인스턴스",
                        "name": "차단기",
                        "state": "현재 상태"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.3.0",
            "spec": {
              "options": {
                "cellHeight": "md",
                "showHeader": true,
                "zebraStriping": false
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음",
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "state"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "options": {
                              "closed": {
                                "color": "green",
                                "index": 0,
                                "text": "CLOSED"
                              },
                              "disabled": {
                                "color": "gray",
                                "index": 4,
                                "text": "DISABLED"
                              },
                              "forced_open": {
                                "color": "red",
                                "index": 3,
                                "text": "FORCED_OPEN"
                              },
                              "half_open": {
                                "color": "orange",
                                "index": 2,
                                "text": "HALF_OPEN"
                              },
                              "metrics_only": {
                                "color": "blue",
                                "index": 5,
                                "text": "METRICS_ONLY"
                              },
                              "open": {
                                "color": "red",
                                "index": 1,
                                "text": "OPEN"
                              }
                            },
                            "type": "value"
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "CB 보호 호출 평균 처리시간",
          "description": "회원·시설 회로별 CB Timer의 count/sum으로 계산한 평균입니다. 순수 Feign HTTP 시간이나 차단된 호출 시간은 아닙니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, name) (rate(resilience4j_circuitbreaker_calls_seconds_sum{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\",kind=~\"successful|failed|ignored\"}[$__rate_interval])) / (sum by (instance, name) (rate(resilience4j_circuitbreaker_calls_seconds_count{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\",kind=~\"successful|failed|ignored\"}[$__rate_interval])) > 0)",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "{{instance}} / {{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음",
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Circuit Breaker 실패율",
          "description": "Resilience4j failure_rate Gauge입니다. 최소 호출 수 미충족의 -1은 표시하지 않으며 0%로 바꾸지 않습니다. Feign HTTP 실패율이 아닙니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "resilience4j_circuitbreaker_failure_rate{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\"} >= 0",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "{{instance}} / {{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "max": 100,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음",
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Circuit Breaker 상태 변화",
          "description": "상태별 값 1은 그 상태가 활성인 시점입니다. open과 closed가 반대로 변하는 흐름을 확인합니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "resilience4j_circuitbreaker_state{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\"}",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "{{instance}} / {{name}} / {{state}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "max": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음",
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "CB 보호 호출량 · 선택 기간",
          "description": "회원·시설 Circuit Breaker가 허용한 호출의 successful, failed, ignored 결과를 회로와 인스턴스별로 표시합니다. 차단된 not_permitted 호출은 별도 지표입니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, name, kind) (increase(resilience4j_circuitbreaker_calls_seconds_count{job=\"sporty-services\",application=\"match-service\",name=~\"MemberClientgetLong|MemberClientprofilesList|FacilityClientgetLong\",kind=~\"successful|failed|ignored\"}[$__range]))",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "{{instance}} / {{name}} / {{kind}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:건",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Feign HTTP 호출량 · 선택 기간",
          "description": "회원·시설 Feign HTTP 요청의 선택 기간 증가량입니다. Client와 HTTP 상태 코드별 건수이며 CB 보호 호출과 Discovery 요청은 포함하지 않습니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, clientName, http_status_code) (increase(sporty_feign_http_requests_seconds_count{job=\"sporty-services\",application=\"match-service\",clientName=~\"com[.]example[.]sporty[.]match[.]integration[.](MemberClient|FacilityClient)\"}[$__range]))",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "{{instance}} / {{clientName}} / HTTP {{http_status_code}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix:건",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Feign HTTP 평균 응답시간 · 선택 기간",
          "description": "회원·시설 Feign HTTP Timer의 선택 기간 sum 증가량을 count 증가량으로 나눈 평균(초)입니다. 요청 증가량이 0이면 값을 표시하지 않습니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, clientName) (increase(sporty_feign_http_requests_seconds_sum{job=\"sporty-services\",application=\"match-service\",clientName=~\"com[.]example[.]sporty[.]match[.]integration[.](MemberClient|FacilityClient)\"}[$__range])) / (sum by (instance, clientName) (increase(sporty_feign_http_requests_seconds_count{job=\"sporty-services\",application=\"match-service\",clientName=~\"com[.]example[.]sporty[.]match[.]integration[.](MemberClient|FacilityClient)\"}[$__range])) > 0)",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "{{instance}} / {{clientName}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "데이터 없음"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Feign HTTP 5xx 오류율 · 선택 기간",
          "description": "회원·시설 Feign HTTP 요청 중 5xx 응답의 비율입니다. 404는 포함하지 않습니다. 요청은 있지만 5xx가 없으면 0%, 요청 증가량이 없으면 데이터 없음입니다. 타임아웃·연결 오류는 5xx 응답이 아닐 수 있습니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
