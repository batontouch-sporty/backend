          "id": 1,
          "title": "Circuit Breaker 현재 상태",
          "description": "현재 활성 상태의 시계열만 표시합니다. application·instance·name·state를 확인합니다. 값 1 자체는 정상 여부가 아니라 해당 state가 활성이라는 뜻입니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "resilience4j_circuitbreaker_state{application=~\".+\"} == 1",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{application}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true,
                        "__name__": true
                      },
                      "renameByName": {
                        "application": "호출 서비스",
                        "instance": "인스턴스",
                        "name": "차단기",
                        "state": "현재 상태"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
