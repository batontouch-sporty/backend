      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "서비스별 p95 응답시간",
          "description": "95%의 요청이 이 시간 안에 완료됩니다. application 태그와 HTTP 응답시간 히스토그램 버킷이 필요합니다. 1초 선은 화면 기준이며 알림 규칙은 아닙니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
