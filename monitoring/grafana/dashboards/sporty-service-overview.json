    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "서비스 상태",
          "description": "지표 수집 성공 여부입니다. UP이 모든 업무 기능의 정상 동작을 보증하지는 않습니다. 현재 서비스 수집이 연결되지 않았다면 데이터 없음이 정상입니다. application 대상 라벨 또는 서비스명 job을 기준으로 조회합니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "sporty-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "up{application=~\".+\"} or up{job=~\"(user|match|facility|ai|notification|gateway|config|discovery)-service\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{job}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true
                      },
                      "renameByName": {
                        "application": "서비스",
                        "instance": "인스턴스",
                        "job": "수집 작업"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
