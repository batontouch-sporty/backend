      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "서비스별 요청량",
          "description": "서비스별 초당 요청 수입니다. application 공통 태그가 필요합니다. Actuator 요청은 제외합니다. 미수집 지표를 0으로 대체하지 않습니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
